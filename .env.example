DIFY_RND_RISK_API_KEY=YOUR_API_KEY
DIFY_RND_RISK_API_URL=http://YOUR_DIFY_SERVER/v1

# 客户特征 AI 提取（客户分析 JIT 脱敏时自动调用）
DIFY_CUSTOMER_FEATURE_EXTRACT_API_KEY=YOUR_API_KEY
DIFY_CUSTOMER_FEATURE_EXTRACT_API_URL=http://YOUR_DIFY_SERVER/v1

# 数字员工助手（/api/digital-employee）
DIFY_DIGITAL_EMPLOYEE_API_KEY=YOUR_API_KEY
DIFY_DIGITAL_EMPLOYEE_API_URL=http://YOUR_DIFY_SERVER/v1/chat-messages

# ── DSH 工作台访问控制（生产环境必须设置为高强度随机值） ──
DSH_ACCESS_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
# 当前站点为 HTTP 时设为 false；迁移 HTTPS 后必须改为 true
DSH_COOKIE_SECURE=false
# WebOS 与 DSH 必须在同一主域名下，例如 .example.com；留空表示不启用 DSH 工作台
DSH_COOKIE_DOMAIN=.example.com
# DSH 使用同一主域名下的独立子域名，例如 https://dsh.example.com
VITE_DSH_EMBED_URL=

# AI 视频分镜生成（/api/video-gen）
DIFY_VIDEOGEN_API_KEY=YOUR_API_KEY
DIFY_VIDEOGEN_API_URL=http://YOUR_DIFY_SERVER/v1/chat-messages

# PostgreSQL 数据库配置（基础资料表 + 应用配置表）
PG_HOST=YOUR_PG_HOST
PG_PORT=YOUR_PG_PORT
PG_DATABASE=YOUR_PG_DATABASE
PG_USER=YOUR_PG_USER
PG_PASSWORD=YOUR_PG_PASSWORD
DATABASE_URL="postgresql://YOUR_PG_USER:YOUR_PG_PASSWORD@YOUR_PG_HOST:YOUR_PG_PORT/YOUR_PG_DATABASE"

# 百度智能云 - 人体检测与属性识别 API
BAIDU_BODY_APP_ID=YOUR_BAIDU_APP_ID
BAIDU_BODY_API_KEY=YOUR_BAIDU_API_KEY
BAIDU_BODY_SECRET_KEY=YOUR_BAIDU_SECRET_KEY
BAIDU_BODY_API_URL=https://aip.baidubce.com/rest/2.0/image-classify/v1/body_attr
BAIDU_BODY_TOKEN_URL=https://aip.baidubce.com/oauth/2.0/token

