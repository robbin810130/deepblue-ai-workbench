# ===== 前端品牌配置（Vite 注入，index.html 与前端代码共用） =====
VITE_APP_TITLE=深智蓝智能体平台软件

# 数据库配置（Python脚本使用）
DB_DRIVER={ODBC Driver 17 for SQL Server}
DB_SERVER=YOUR_DB_SERVER_IP
DB_DATABASE=YOUR_DB_NAME
DB_UID=YOUR_DB_USER
DB_PWD=YOUR_DB_PASSWORD

# 后端服务器配置 (开发模式默认 3001)
SERVER_PORT=3001

# Dify API 配置
# 请将下方的 YOUR_API_KEY 替换为您部署环境对应的真实 API Key

# 销售数据智能分析（AI分析引擎，前端 /api/ai-analysis）
DIFY_CHATFLOW_API_KEY=YOUR_API_KEY
DIFY_CHATFLOW_API_URL=http://YOUR_DIFY_SERVER/v1/chat-messages

# 市场洞察（/api/market-insight）
