DIFY_ORDER_PAGE_API_KEY=YOUR_API_KEY
DIFY_ORDER_PAGE_API_URL=http://YOUR_DIFY_SERVER/v1

# 复盘搭子-交易情况（server/reviewPartnerRoutes.js）
DIFY_TRANSACTION_API_KEY=YOUR_API_KEY
DIFY_TRANSACTION_API_URL=http://YOUR_DIFY_SERVER/v1

# 物流费计算-模型自动识别商品尺寸重量（server/logisticsConfigRoutes.js）
DIFY_LOGISTICS_RECOGNIZE_API_KEY=YOUR_API_KEY
DIFY_LOGISTICS_RECOGNIZE_API_URL=http://YOUR_DIFY_SERVER/v1

# ==================== 定时任务与自动化功能开关 ====================
# 设为 false 可禁用对应功能，适用于测试环境或特定场景
# 默认均为 true（启用）

# 每日新闻自动更新与推送（每分钟检查用户设定的推送时间）
ENABLE_NEWS_CRON=true

# 销售数据自动更新（每小时整点执行 Python 脚本刷新数据）
ENABLE_DATA_UPDATE_CRON=true

# 月度预测基线自动生成（每月1号凌晨2点）
ENABLE_MONTHLY_FORECAST_CRON=true

# 销售偏差跟踪（每月5/10/15/20/25号早上8点）
ENABLE_DEVIATION_TRACKING_CRON=true

# 月度预测补跑自检（每月2~7号凌晨3点，保障月初宕机时的补跑）
ENABLE_FORECAST_BACKUP_CRON=true

# 招标检索定时任务（默认禁用，设为 true 启用，每天凌晨2点自动调用 Dify 获取招标数据）
ENABLE_TENDER_SEARCH_CRON=true

# 启动时自动检测当月预测基线（服务启动后延迟执行）
ENABLE_STARTUP_BASELINE_CHECK=true

# 启动自检延迟时间（毫秒），仅当 ENABLE_STARTUP_BASELINE_CHECK=true 时生效
STARTUP_BASELINE_CHECK_DELAY=5000

# ============================================================
# 企业资质库模块 (Enterprise Qualification Library)
# ============================================================
# 凭证加密密钥（64位 hex = 32字节，用于 AES-256-GCM）
# 生成方式: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EQ_ENCRYPTION_KEY=your-64-char-hex-key-for-aes-256-gcm-encryption

# 企业资质库 Dify 知识库同步（server/enterpriseQualificationRoutes.js）
DIFY_EQ_KNOWLEDGE_API_KEY=YOUR_API_KEY
DIFY_EQ_KNOWLEDGE_API_URL=http://YOUR_DIFY_SERVER/v1

# ==================== 业务看板（Dify 发布能力） ====================
# Dify「发布到业务看板」内部令牌：Dify 工作流 HTTP 节点 Header X-Internal-Token 必须与此值一致
# 生产配置位置：ecosystem.config.cjs 的 env_production（server.js 不加载 dotenv）
DASHBOARD_PUBLISH_TOKEN=REPLACE_WITH_LONG_RANDOM_TOKEN

# 看板永久访问地址前缀（拼进 view_url 返回给 Dify），需浏览器可达，如 http://stdeepblue.eicp.net:8081
APP_BASE_URL=

# 可选：AI 看板 HTML 存储目录（默认 server/storage/business-dashboards）
# DASHBOARD_STORAGE_DIR=

# ── D4 试点：存量路由 → 任务中心迁移桥（legacyBridge）────────────
# 逗号分隔 skill_key；未列出的技能走旧直连路径。试点：invoice_verify、quote_verify
# 下一批：hazard_detection（需前端改传暂存 file_id）、tender_search（落库副作用需并入执行器）
TASK_CENTER_PILOT=
