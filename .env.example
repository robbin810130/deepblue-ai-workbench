# Dify API 基础 URL（知识库管理通用基址）
DIFY_API_BASE_URL=http://YOUR_DIFY_SERVER/v1

# 招标知识库（独立数据集 ID）
DIFY_TENDER_KNOWLEDGE_DATASET_ID=YOUR_DATASET_ID

